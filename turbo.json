{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "cache": false,
      "persistent": true,
      "env": [
        "MONGODB_URL",
        "FRONTEND_URL",
        "JWT_SECRET",
        "MAIL_USER",
        "NODE_ENV",
        "PORT",
        "MAIL_PASS",
        "MAIL_HOST"
      ]
    }
  }
}
